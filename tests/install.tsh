# setup
apk add --no-cache curl > /dev/null
echo "# docs mention go2dir.sh but do not load it" > $HOME/.bashrc
touch $HOME/.zshrc

test bash install
assert_success
assert_stdout "Go2dir has been successfully installed"
assert_file "$HOME/.go2dir/go2dir.sh"
assert_file "$HOME/.local/share/go2dir/locations.txt"

test cat $HOME/.bashrc
assert_success
assert_stdout "### GO2DIR LOADER START ###"
assert_stdout "source \"$HOME/.go2dir/go2dir.sh\""
assert_stdout "### GO2DIR LOADER END ###"

test cat $HOME/.zshrc
assert_success
assert_stdout "### GO2DIR LOADER START ###"
assert_stdout "source \"$HOME/.go2dir/go2dir.sh\""
assert_stdout "### GO2DIR LOADER END ###"

test bash install
assert_success
assert_stdout "Go2dir has been successfully installed"

grep -F -c "### GO2DIR LOADER START ###" $HOME/.bashrc > $STDOUT 2>$STDERR
RETURNCODE=$?
COMMAND='grep -F -c "### GO2DIR LOADER START ###" $HOME/.bashrc'
assert_success
assert_stdout "^1$"

grep -F -c "### GO2DIR LOADER START ###" $HOME/.zshrc > $STDOUT 2>$STDERR
RETURNCODE=$?
COMMAND='grep -F -c "### GO2DIR LOADER START ###" $HOME/.zshrc'
assert_success
assert_stdout "^1$"

mkdir -p /tmp/go2dir_fakebin
cat <<-EOS > /tmp/go2dir_fakebin/curl
#!/usr/bin/env sh
exit 22
EOS
chmod +x /tmp/go2dir_fakebin/curl
rm -rf /tmp/go2dir_failed_home

test env RELEASE=alpha PATH=/tmp/go2dir_fakebin:$PATH HOME=/tmp/go2dir_failed_home bash install
assert_fail 1
assert_stderr "Install failed: could not download https://github.com/alexandreprates/go2dir/archive/master.tar.gz"
assert_not_stdout "Go2dir has been successfully installed"
