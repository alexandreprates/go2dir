#compdef go2

# Complete literal directory aliases without interpreting description separators.

local go2_name go2_location
local -a go2_aliases go2_options
go2_aliases=()

if [[ -f ${LOCATIONS2GO-} && -r ${LOCATIONS2GO-} ]]; then
  while IFS='|' read -r go2_name go2_location || [[ -n $go2_name ]]; do
    [[ -n $go2_name ]] && go2_aliases+=("$go2_name")
  done < "$LOCATIONS2GO"
fi

if (( CURRENT == 2 )) || { (( CURRENT == 3 )) && [[ $words[2] == -R || $words[2] == -- ]]; }; then
  compadd -a go2_aliases
  if (( CURRENT == 2 )); then
    go2_options=(-a -l -r -R -v -h)
    compadd -a go2_options
  fi
fi

return 0
