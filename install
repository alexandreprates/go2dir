# go2dir installation script
# Source: https://github.com/alexandreprates/go2dir

echo "Preparing to install go2dir"

SOURCEGO2DIR=$HOME/.go2dir/go2dir.sh
LOCATIONS2GO=$HOME/.local/share/go2dir/locations.txt

function fail_install() {
  echo "Installation failed: $1" >&2
  exit 1
}

case ${RELEASE-} in
    alpha)
      echo "Using the alpha version"
      SOURCEURL="https://github.com/alexandreprates/go2dir/archive/master.tar.gz"
    ;;
    beta)
      echo "Using the beta version"
      SOURCEURL="https://github.com/alexandreprates/go2dir/archive/dev.tar.gz"
    ;;
    *)
      LATEST_RELEASE=$(curl -fsSL -H 'Accept: application/json' https://github.com/alexandreprates/go2dir/releases/latest) || fail_install "could not fetch latest release metadata"
      LAST_VERSION=$(echo "$LATEST_RELEASE" | cut -d \" -f 6)
      [[ -z $LAST_VERSION ]] && fail_install "could not resolve latest release version"
      SOURCEURL="https://github.com/alexandreprates/go2dir/archive/$LAST_VERSION.tar.gz"
    ;;
esac

function set_loader() {
  if [[ -a "$1" ]] && ! grep -F "### GO2DIR LOADER START ###" "$1" > /dev/null 2>&1; then
    cat <<-'EOS' >> "$1"
  ### GO2DIR LOADER START ###
  # Enable the go2 command.
  [[ -a "$HOME/.go2dir/go2dir.sh" ]] && source "$HOME/.go2dir/go2dir.sh"
  ### GO2DIR LOADER END ###
EOS
  else
    return 0
  fi
}

# Create the locations file.
mkdir -p -- "$(dirname -- "$LOCATIONS2GO")" || fail_install "could not create locations directory"
if [[ ! -f "$LOCATIONS2GO" ]]; then
  touch -- "$LOCATIONS2GO" || fail_install "could not create locations file"
fi
[[ -f "$LOCATIONS2GO" ]] || fail_install "locations file is not a regular file"

# Install the source files.
mkdir -p -- "$(dirname -- "$SOURCEGO2DIR")" || fail_install "could not create installation directory"
ARCHIVE=$(mktemp) || fail_install "could not create download file"
trap 'rm -f "$ARCHIVE"' EXIT
curl -fsSL "$SOURCEURL" -o "$ARCHIVE" || fail_install "could not download $SOURCEURL"
tar -xzf "$ARCHIVE" -C "$(dirname "$SOURCEGO2DIR")" --strip 1 || fail_install "could not extract $SOURCEURL"
rm -f "$ARCHIVE"
trap - EXIT
[[ ! -f "$SOURCEGO2DIR" ]] && fail_install "source file was not installed"

# Keep the same lock protocol as the runtime, without sourcing downloaded code.
function with_locations_lock() (
  local LOCK_DIR="$LOCATIONS2GO.lock" ATTEMPTS=0 GO2DIR_TEMP=''
  until mkdir -- "$LOCK_DIR" 2>/dev/null; do
    if [ "$ATTEMPTS" -ge 100 ]; then
      printf "Could not lock locations file: %s\n" "$LOCATIONS2GO" >&2
      return 1
    fi
    sleep 0.1 || return 1
    ATTEMPTS=$((ATTEMPTS + 1))
  done
  trap 'if [ -n "$GO2DIR_TEMP" ]; then rm -f -- "$GO2DIR_TEMP"; fi; rmdir -- "$LOCK_DIR"' EXIT
  trap 'exit 1' HUP INT TERM
  "$@"
)

function __migrate_locations() {
  local LINE='' NAME
  GO2DIR_TEMP=$(mktemp "$LOCATIONS2GO.XXXXXX") || return 1
  while IFS= read -r LINE || [ -n "$LINE" ]; do
    [ -n "$LINE" ] || continue
    if [[ "$LINE" != *"|"* ]]; then
      NAME=$(basename -- "$LINE") || return 1
      NAME="${NAME// /-}"
      printf "%s|%s\n" "$NAME" "$LINE" >> "$GO2DIR_TEMP" || return 1
    else
      printf "%s\n" "$LINE" >> "$GO2DIR_TEMP" || return 1
    fi
  done < "$LOCATIONS2GO" || return 1
  mv -f -- "$GO2DIR_TEMP" "$LOCATIONS2GO"
}

with_locations_lock __migrate_locations || fail_install "could not migrate locations"

# Add loaders to shell configuration files.
set_loader "$HOME/.bashrc" || fail_install "could not update .bashrc"
set_loader "$HOME/.zshrc" || fail_install "could not update .zshrc"

printf "\n\ngo2dir has been successfully installed.\nStart a new shell session to enable the go2 command.\n"
