# Go2Dir Install Script
# source: https://github.com/alexandreprates/go2dir

echo "Preparing to install Go2Dir"

SOURCEGO2DIR=$HOME/.go2dir/go2dir.sh
LOCATIONS2GO=$HOME/.local/share/go2dir/locations.txt

function fail_install() {
  echo "Install failed: $1" >&2
  exit 1
}

case $RELEASE in
    alpha)
      echo "Using alpha version!"
      SOURCEURL="https://github.com/alexandreprates/go2dir/archive/master.tar.gz"
    ;;
    beta)
      echo "Using beta version!"
      SOURCEURL="https://github.com/alexandreprates/go2dir/archive/dev.tar.gz"
    ;;
    *)
      LATEST_RELEASE=$(curl -fsSL -H 'Accept: application/json' https://github.com/alexandreprates/go2dir/releases/latest) || fail_install "could not fetch latest release metadata"
      LAST_VERSION=$(echo "$LATEST_RELEASE" | cut -d \" -f 6)
      [[ -z $LAST_VERSION ]] && fail_install "could not resolve latest release version"
      SOURCEURL="https://github.com/alexandreprates/go2dir/archive/$LAST_VERSION.tar.gz"
    ;;
esac

function set_loader() {
  if [[ -a "$1" ]] && ! grep -F "### GO2DIR LOADER START ###" "$1" > /dev/null 2>&1; then
    cat <<-EOS >> "$1"
  ### GO2DIR LOADER START ###
  # Enable go2 command
  [[ -a "$SOURCEGO2DIR" ]] && source "$SOURCEGO2DIR"
  ### GO2DIR LOADER END ###
EOS
  fi
}

# Creating locations
[[ ! -d `dirname $LOCATIONS2GO` ]] && mkdir -p `dirname $LOCATIONS2GO`
[[ ! -f $LOCATIONS2GO ]] && touch $LOCATIONS2GO

# Placing source
mkdir -p `dirname $SOURCEGO2DIR`
ARCHIVE=$(mktemp)
trap 'rm -f "$ARCHIVE"' EXIT
curl -fsSL "$SOURCEURL" -o "$ARCHIVE" || fail_install "could not download $SOURCEURL"
tar -xzf "$ARCHIVE" -C `dirname $SOURCEGO2DIR` --strip 1 || fail_install "could not extract $SOURCEURL"
rm -f "$ARCHIVE"
trap - EXIT
[[ ! -f $SOURCEGO2DIR ]] && fail_install "source file was not installed"

# Adding to load rc
set_loader "$HOME/.bashrc"
set_loader "$HOME/.zshrc"

# Migrating old locations to new format
source "$SOURCEGO2DIR"
go2 -h > /dev/null # Load internal functions. I need this to use __alias_for_dir
while IFS= read -r LINE; do
  if [[ ! $LINE =~ \| ]]; then
      printf "%s|%s\n" "$(__alias_for_dir "$LINE")" "$LINE" >> "$LOCATIONS2GO.tmp"
  else
      printf "%s\n" "$LINE" >> "$LOCATIONS2GO.tmp"
  fi
done < "$LOCATIONS2GO"
mv "$LOCATIONS2GO.tmp" "$LOCATIONS2GO"

echo -e "\n\nGo2dir has been successfully installed.\nStart a new session to enable it. And enjoy!"
